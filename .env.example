# IB Copilot — environment configuration
# Copy this file to .env (in the project root, OR one directory above it) and fill in
# your key. Never commit a real .env. The app checks ./.env first, then ../.env.

# --- Required: course model via the Portkey gateway ---
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna

# --- Optional: personal OpenAI key (only if you set USE_DIRECT_OPENAI=1) ---
# OPENAI_API_KEY=your_openai_key_here
# USE_DIRECT_OPENAI=0

# --- Optional: live news for Agent C (Markets & Deals). If unset, the app uses a
#     clearly-labeled SAMPLE dataset and never presents it as live news. ---
# NEWS_API_KEY=your_newsapi_key_here
# NEWS_API_PROVIDER=newsapi

# --- Optional: Microsoft Outlook (Agent D). If unset, the app works fully with
#     manual contacts + .ics calendar import. See README for least-privilege setup. ---
# MS_CLIENT_ID=your_azure_app_client_id
# MS_TENANT_ID=common
